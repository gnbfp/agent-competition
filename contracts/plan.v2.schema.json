{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plan.json v2.0 — 有自检的下周草案",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "athlete_id",
    "week_start",
    "status",
    "baseline_trimp",
    "hold_reasons",
    "weekly_targets",
    "days",
    "adjustments",
    "self_check",
    "attempts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "athlete_id": {
      "type": "string"
    },
    "week_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "hold_for_review",
        "awaiting_input"
      ]
    },
    "baseline_trimp": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "hold_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weekly_targets": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "load_target_trimp",
        "sessions"
      ],
      "properties": {
        "load_target_trimp": {
          "type": "number",
          "minimum": 0
        },
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "kind",
          "duration_s",
          "duration_min",
          "distance_m",
          "reference_avg_hr_bpm",
          "target_pace_s_per_km",
          "rules",
          "planned_trimp"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "easy",
              "rest"
            ]
          },
          "duration_s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24000
          },
          "duration_min": {
            "type": "number",
            "minimum": 0,
            "maximum": 400
          },
          "distance_m": {
            "type": "number",
            "minimum": 0
          },
          "reference_avg_hr_bpm": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 30,
            "maximum": 250
          },
          "target_pace_s_per_km": {
            "type": "null"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R\\d{2}$"
            }
          },
          "planned_trimp": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "adjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "reason",
          "action"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^R\\d{2}$"
          },
          "reason": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "checks"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "passed",
              "detail"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "R19",
                  "R20"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round",
          "planned_trimp",
          "checks"
        ],
        "properties": {
          "round": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "planned_trimp": {
            "type": "number",
            "minimum": 0
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "passed",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "R19",
                    "R20"
                  ]
                },
                "passed": {
                  "type": "boolean"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
