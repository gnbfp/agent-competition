{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plan.json — 周训练计划（P4 agent 产出）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "athlete_id",
    "week_start",
    "weekly_targets",
    "days",
    "self_check"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "athlete_id": {
      "type": "string"
    },
    "week_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "weekly_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "load_target_trimp",
        "sessions",
        "long_run_max_pct"
      ],
      "properties": {
        "load_target_trimp": {
          "type": "number",
          "minimum": 0
        },
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14
        },
        "long_run_max_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "intensity_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "kind",
          "duration_min",
          "rules"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "rest",
              "easy",
              "tempo",
              "interval",
              "long",
              "race",
              "cross",
              "other"
            ]
          },
          "duration_min": {
            "type": "number",
            "minimum": 0,
            "maximum": 400
          },
          "distance_m": {
            "type": "number",
            "minimum": 0
          },
          "target_pace_s_per_km": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 120,
            "maximum": 1200
          },
          "hr_zone": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Z1",
              "Z2",
              "Z3",
              "Z4",
              "Z5",
              null
            ]
          },
          "purpose": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R\\d{2}$"
            }
          }
        }
      }
    },
    "adjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "reason",
          "action"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^R\\d{2}$"
          },
          "reason": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "checks"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "passed",
              "detail"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
